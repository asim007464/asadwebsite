# Copy to `.env.local` and replace placeholders. Next.js loads `.env.local` for local dev.

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email / OTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Site <noreply@example.com>"
MAIL_ADMIN_TO=admin@example.com

# Admin (/admin/login)
ADMIN_PASSWORD=
# Used for signed admin cookies; use a long random string in production
ADMIN_SESSION_SECRET=

# Optional: extra image hostnames for next/image (comma-separated)
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=cdn.example.com
